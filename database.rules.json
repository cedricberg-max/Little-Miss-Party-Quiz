              ".validate": "newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 80 && newData.child('audioId').isString() && newData.child('audioId').val().matches(/^[0-9a-f]{16}$/) && (!newData.child('artist').exists() || (newData.child('artist').isString() && newData.child('artist').val().length <= 80)) && (!newData.child('rights').exists() || (newData.child('rights').isString() && newData.child('rights').val().length <= 120))",
              "$other": {
                ".validate": "$other === 'title' || $other === 'artist' || $other === 'audioId' || $other === 'rights' || $other === 'source' || $other === 'points' || $other === 'imageId' || $other === 'duration'"
              },
              "source": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "points": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
              },
              "imageId": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{16}$/)"
              },
              "duration": {
                ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 45"
              }
            }
          }
        }
