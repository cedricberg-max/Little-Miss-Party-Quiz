{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        "hostUid": {
          ".read": "auth != null"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "log": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$seq": {
            ".write": "auth != null && !data.exists() && root.child('games').child($code).child('hostUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['seq', 'at', 'type'])"
          }
        },
        "teams": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostUid').exists()",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('color').isString() && newData.child('color').val().length <= 9"
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('teams').child($uid).exists()",
            ".validate": "newData.child('online').isBoolean() && newData.child('at').isNumber()"
          }
        },
        "answers": {
          "$qid": {
            ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($code).child('teams').child($uid).exists() && root.child('games').child($code).child('state/phase').val() === 'question' && root.child('games').child($code).child('state/paused').val() !== true && root.child('games').child($code).child('state/qid').val() === $qid && now <= root.child('games').child($code).child('state/deadline').val() + 2000",
              ".validate": "newData.hasChildren(['choice', 'at']) && newData.child('choice').isNumber() && root.child('games').child($code).child('state/choices').child(newData.child('choice').val() + '').exists() && newData.child('at').val() === now",
              "$other": {
                ".validate": "$other === 'choice' || $other === 'at'"
              }
            }
          }
        },
        "buzz": {
          ".read": "auth != null",
          "$round": {
            ".write": "auth != null && !data.exists() && newData.child('team').val() === auth.uid && data.parent().parent().child('teams').child(auth.uid).exists() && data.parent().parent().child('state/buzzOpen').val() === true && data.parent().parent().child('state/round').val() + '' === $round"
          }
        },
        "pairing": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.exists()) || (root.child('games').child($code).child('hostUid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.child('at').val() === now && newData.child('pin').isString() && newData.child('pin').val().matches(/^[0-9]{4}$/)",
            "$other": {
              ".validate": "$other === 'pin' || $other === 'at'"
            }
          }
        },
        "pairingResult": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
          }
        },
        "pairingLock": {
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "regie": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || (auth.uid === $uid && !data.exists() && root.child('games').child($code).child('hostUid').exists() && root.child('games').child($code).child('state/phase').val() !== 'ended' && root.child('settings/regie/hash').isString() && root.child('regieProof').child(auth.uid).child('hash').val() === root.child('settings/regie/hash').val() && root.child('regieGate/try').child('uid').val() === auth.uid && root.child('regieProof').child(auth.uid).child('gateAt').val() === root.child('regieGate/try').child('at').val() && root.child('regieGate/try').child('at').val() > now - 10000))",
            ".validate": "!newData.exists() || (newData.child('pairedAt').isNumber() && (newData.child('via').val() === 'pin' || (newData.child('via').val() === 'password' && newData.child('pairedAt').val() === now)))"
          }
        },
        "conducteur": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "commands": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$cmd": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            ".validate": "newData.child('type').isString() && newData.child('type').val().matches(/^(next|pause|resume|close|adjust|undo|end)$/) && newData.child('expectSeq').isNumber() && newData.child('by').val() === auth.uid && newData.child('at').val() === now",
            "team": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "delta": {
              ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500"
            },
            "target": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": "$other === 'type' || $other === 'expectSeq' || $other === 'by' || $other === 'at'"
            }
          }
        },
        "commandStatus": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$cmd": {
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid",
          ".validate": "newData.child('title').isString() && newData.child('title').val().length <= 120 && (!newData.child('childName').exists() || (newData.child('childName').isString() && newData.child('childName').val().length <= 40))"
        },
        "show": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists() && root.child('games').child($code).child('state/phase').val() === 'lobby'",
          ".validate": "newData.hasChildren(['id', 'title', 'quiz', 'by', 'at']) && newData.child('id').isString() && newData.child('id').val().length <= 40 && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('quiz/questions').exists() && newData.child('by').val() === auth.uid && newData.child('at').val() === now",
          "childName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "showStatus": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        }
      }
    },
    "settings": {
      "regie": {
        ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
        ".validate": "newData.hasChildren(['salt', 'hash', 'updatedAt']) && newData.child('salt').isString() && newData.child('salt').val().length >= 16 && newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('updatedAt').val() === now",
        "salt": {
          ".read": "auth != null"
        },
        "updatedAt": {
          ".read": "auth != null"
        }
      },
      "admin": {
        ".write": "auth != null && newData.exists() && (!data.exists() || (auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()))",
        ".validate": "newData.hasChildren(['salt', 'hash', 'updatedAt']) && newData.child('salt').isString() && newData.child('salt').val().length >= 16 && newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('updatedAt').val() === now",
        "salt": {
          ".read": "auth != null"
        },
        "updatedAt": {
          ".read": "auth != null"
        }
      }
    },
    "library": {
      ".read": "(auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()) || (auth != null && root.child('settings/regie/hash').isString() && root.child('regieProof').child(auth.uid).child('hash').val() === root.child('settings/regie/hash').val())",
      "quizzes": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
          ".validate": "!newData.exists() || (newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 120 && newData.child('questions').hasChildren() && newData.child('updatedAt').val() === now)",
          "questions": {
            "$i": {
              ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 300 && newData.child('choices').hasChildren() && newData.child('correct').isNumber() && newData.child('status').val().matches(/^(brouillon|validee)$/)",
              "duration": {
                ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
              }
            }
          }
        }
      },
      "shows": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
          ".validate": "!newData.exists() || (newData.child('childName').isString() && newData.child('childName').val().length >= 1 && newData.child('childName').val().length <= 40 && newData.child('status').isString() && newData.child('status').val().matches(/^(brouillon|publiee|archivee)$/) && newData.child('updatedAt').val() === now)"
        }
      }
    },
    "regieGate": {
      "try": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('at').val() < now - 2000)",
        ".validate": "newData.child('uid').val() === auth.uid && newData.child('at').val() === now"
      }
    },
    "regieProof": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('regieGate/try').child('uid').val() === auth.uid && newData.child('gateAt').val() === root.child('regieGate/try').child('at').val() && (!data.exists() || data.child('gateAt').val() !== newData.child('gateAt').val())",
        ".validate": "newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('gateAt').isNumber() && newData.child('at').val() === now",
        "$other": {
          ".validate": "$other === 'hash' || $other === 'gateAt' || $other === 'at'"
        }
      }
    },
    "adminProof": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('regieGate/try').child('uid').val() === auth.uid && newData.child('gateAt').val() === root.child('regieGate/try').child('at').val() && (!data.exists() || data.child('gateAt').val() !== newData.child('gateAt').val())))",
        ".validate": "newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('gateAt').isNumber() && newData.child('at').val() === now",
        "$other": {
          ".validate": "$other === 'hash' || $other === 'gateAt' || $other === 'at'"
        }
      }
    },
    "adminAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('settings/admin/hash').isString() && root.child('adminProof').child($uid).child('hash').val() === root.child('settings/admin/hash').val()"
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('kind').isString() && newData.child('kind').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length <= 20000 && newData.child('at').val() === now"
      }
    }
  }
}
