{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && data.child('hostUid').val() === auth.uid",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        "hostUid": {
          ".read": "auth != null"
        },
        "state": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "log": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$seq": {
            ".write": "auth != null && !data.exists() && root.child('games').child($code).child('hostUid').val() === auth.uid",
            ".validate": "newData.hasChildren(['seq', 'at', 'type'])"
          }
        },
        "teams": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || (auth.uid === $uid && root.child('games').child($code).child('hostUid').exists() && (!root.child('games').child($code).child('state/phase').exists() || root.child('games').child($code).child('state/phase').val() === 'lobby') && !data.child('device').exists() && !newData.child('device').exists()))",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('color').isString() && newData.child('color').val().length <= 9 && (root.child('games').child($code).child('hostUid').val() === auth.uid || newData.parent().parent().child('colors').child(newData.child('color').val().toUpperCase().replace('#', '')).val() === $uid)",
            "device": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            }
          }
        },
        "colors": {
          ".read": "auth != null",
          "$hex": {
            ".write": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || (newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid) && root.child('games').child($code).child('hostUid').exists() && (!root.child('games').child($code).child('state/phase').exists() || root.child('games').child($code).child('state/phase').val() === 'lobby')))",
            ".validate": "newData.isString() && $hex.matches(/^[0-9A-F]{6}$/) && newData.parent().parent().child('teams').child(newData.val()).child('color').isString() && newData.parent().parent().child('teams').child(newData.val()).child('color').val().toUpperCase() === '#' + $hex"
          }
        },
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && root.child('games').child($code).child('teams').child($uid).exists() && (root.child('games').child($code).child('teams').child($uid).child('device').val() === auth.uid || (!root.child('games').child($code).child('teams').child($uid).child('device').exists() && auth.uid === $uid))",
            ".validate": "newData.child('online').isBoolean() && newData.child('at').isNumber()"
          }
        },
        "joinRequests": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games').child($code).child('hostUid').exists() && ((auth.uid === $uid && (!newData.exists() || root.child('games').child($code).child('state/phase').val() !== 'ended')) || (!newData.exists() && (root.child('games').child($code).child('hostUid').val() === auth.uid || root.child('games').child($code).child('regie').child(auth.uid).exists())))",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 20 && newData.child('color').isString() && newData.child('color').val().length <= 9 && newData.child('at').val() === now",
            "$other": {
              ".validate": "$other === 'name' || $other === 'color' || $other === 'at'"
            }
          }
        },
        "answers": {
          "$qid": {
            ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid && !newData.exists()",
            "$uid": {
              ".read": "auth != null && (root.child('games').child($code).child('teams').child($uid).child('device').val() === auth.uid || (!root.child('games').child($code).child('teams').child($uid).child('device').exists() && auth.uid === $uid))",
              ".write": "auth != null && (root.child('games').child($code).child('teams').child($uid).child('device').val() === auth.uid || (!root.child('games').child($code).child('teams').child($uid).child('device').exists() && auth.uid === $uid)) && !data.exists() && root.child('games').child($code).child('teams').child($uid).exists() && root.child('games').child($code).child('state/phase').val() === 'question' && root.child('games').child($code).child('state/paused').val() !== true && (!root.child('games').child($code).child('state/resumeAt').exists() || now >= root.child('games').child($code).child('state/resumeAt').val()) && root.child('games').child($code).child('state/qid').val() === $qid && now <= root.child('games').child($code).child('state/deadline').val() + 2000",
              ".validate": "newData.hasChildren(['choice', 'at']) && newData.child('choice').isNumber() && ((root.child('games').child($code).child('state/kind').val() !== 'number' && root.child('games').child($code).child('state/choices').child(newData.child('choice').val() + '').exists()) || (root.child('games').child($code).child('state/kind').val() === 'number' && newData.child('choice').val() >= -999999999 && newData.child('choice').val() <= 999999999 && newData.child('choice').val() % 1 === 0)) && newData.child('at').val() === now",
              "$other": {
                ".validate": "$other === 'choice' || $other === 'at'"
              }
            }
          }
        },
        "buzz": {
          ".read": "auth != null",
          "$round": {
            ".write": "auth != null && !data.exists() && newData.child('team').isString() && root.child('games').child($code).child('teams').child(newData.child('team').val()).exists() && (root.child('games').child($code).child('teams').child(newData.child('team').val()).child('device').val() === auth.uid || (!root.child('games').child($code).child('teams').child(newData.child('team').val()).child('device').exists() && auth.uid === newData.child('team').val())) && data.parent().parent().child('state/buzzOpen').val() === true && data.parent().parent().child('state/round').val() + '' === $round && !data.parent().parent().child('state/buzzBlocked').child(newData.child('team').val()).exists()"
          }
        },
        "fun": {
          ".read": "auth != null",
          "$team": {
            ".write": "auth != null && newData.exists() && root.child('games').child($code).child('teams').child($team).exists() && (root.child('games').child($code).child('teams').child($team).child('device').val() === auth.uid || (!root.child('games').child($code).child('teams').child($team).child('device').exists() && auth.uid === $team)) && root.child('games').child($code).child('state/phase').val() === 'lobby'",
            ".validate": "newData.hasChildren(['at']) && newData.child('at').val() === now && (!data.exists() || now - data.child('at').val() >= 250)",
            "$other": {
              ".validate": "$other === 'at'"
            }
          }
        },
        "pairing": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.exists()) || (root.child('games').child($code).child('hostUid').val() === auth.uid && !newData.exists()))",
            ".validate": "newData.child('at').val() === now && newData.child('pin').isString() && newData.child('pin').val().matches(/^[0-9]{4}$/)",
            "$other": {
              ".validate": "$other === 'pin' || $other === 'at'"
            }
          }
        },
        "pairingResult": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
          }
        },
        "pairingLock": {
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "regie": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || (auth.uid === $uid && !data.exists() && root.child('games').child($code).child('hostUid').exists() && root.child('games').child($code).child('state/phase').val() !== 'ended' && root.child('settings/regie/hash').isString() && root.child('regieProof').child(auth.uid).child('hash').val() === root.child('settings/regie/hash').val() && root.child('regieGate/try').child('uid').val() === auth.uid && root.child('regieProof').child(auth.uid).child('gateAt').val() === root.child('regieGate/try').child('at').val() && root.child('regieGate/try').child('at').val() > now - 10000))",
            ".validate": "!newData.exists() || (newData.child('pairedAt').isNumber() && (newData.child('via').val() === 'pin' || (newData.child('via').val() === 'password' && newData.child('pairedAt').val() === now)))"
          }
        },
        "conducteur": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        },
        "commands": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$cmd": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            ".validate": "newData.child('type').isString() && newData.child('type').val().matches(/^(next|pause|resume|close|adjust|undo|end|admit|replace|mime_start|mime_found|mime_pass|mime_fix|mime_stop|goto|buzz_ok|buzz_ko|buzz_bonus|statues_win|blind_play|blind_unblock|blind_reveal|blind_skip|blind_cut)$/) && newData.child('expectSeq').isNumber() && newData.child('by').val() === auth.uid && newData.child('at').val() === now",
            "team": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "delta": {
              ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500"
            },
            "target": {
              ".validate": "newData.isNumber()"
            },
            "device": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "index": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 500"
            },
            "qid": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": "$other === 'type' || $other === 'expectSeq' || $other === 'by' || $other === 'at'"
            }
          }
        },
        "commandStatus": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          "$cmd": {
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
          }
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid",
          ".validate": "newData.child('title').isString() && newData.child('title').val().length <= 120 && (!newData.child('childName').exists() || (newData.child('childName').isString() && newData.child('childName').val().length <= 40))"
        },
        "show": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists() && (root.child('games').child($code).child('state/phase').val() === 'lobby' || (newData.child('base').isString() && root.child('games').child($code).child('state/phase').val() !== 'ended'))",
          ".validate": "newData.hasChildren(['id', 'title', 'quiz', 'by', 'at']) && newData.child('id').isString() && newData.child('id').val().length <= 40 && newData.child('title').isString() && newData.child('title').val().length <= 120 && newData.child('quiz/questions').exists() && newData.child('by').val() === auth.uid && newData.child('at').val() === now",
          "childName": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "base": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "images": {
          "$id": {
            ".read": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || root.child('games').child($code).child('regie').child(auth.uid).exists())",
            ".write": "auth != null && !data.exists() && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            ".validate": "$id.matches(/^[0-9a-f]{16}$/) && newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 150000"
          }
        },
        "sounds": {
          "$id": {
            ".read": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || root.child('games').child($code).child('regie').child(auth.uid).exists())",
            ".write": "auth != null && !data.exists() && root.child('games').child($code).child('regie').child(auth.uid).exists()",
            ".validate": "$id.matches(/^[0-9a-f]{16}$/) && newData.isString() && newData.val().beginsWith('data:audio/mpeg;base64,') && newData.val().length <= 900000"
          }
        },
        "media": {
          ".read": "auth != null && (root.child('games').child($code).child('hostUid').val() === auth.uid || root.child('games').child($code).child('regie').child(auth.uid).exists())",
          "$id": {
            ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid",
            ".validate": "$id.matches(/^[0-9a-f]{16}$/) && newData.isString() && newData.val().matches(/^(ok|loading|missing)$/)"
          }
        },
        "showStatus": {
          ".read": "auth != null && root.child('games').child($code).child('regie').child(auth.uid).exists()",
          ".write": "auth != null && root.child('games').child($code).child('hostUid').val() === auth.uid"
        }
      }
    },
    "settings": {
      "regie": {
        ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
        ".validate": "newData.hasChildren(['salt', 'hash', 'updatedAt']) && newData.child('salt').isString() && newData.child('salt').val().length >= 16 && newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('updatedAt').val() === now",
        "salt": {
          ".read": "auth != null"
        },
        "updatedAt": {
          ".read": "auth != null"
        }
      },
      "admin": {
        ".write": "auth != null && newData.exists() && (!data.exists() || (auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()))",
        ".validate": "newData.hasChildren(['salt', 'hash', 'updatedAt']) && newData.child('salt').isString() && newData.child('salt').val().length >= 16 && newData.child('hash').isString() && newData.child('hash').val().matches(/^[0-9a-f]{64}$/) && newData.child('updatedAt').val() === now",
        "salt": {
          ".read": "auth != null"
        },
        "updatedAt": {
          ".read": "auth != null"
        }
      }
    },
    "library": {
      ".read": "(auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()) || (auth != null && root.child('settings/regie/hash').isString() && root.child('regieProof').child(auth.uid).child('hash').val() === root.child('settings/regie/hash').val())",
      "quizzes": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
          ".validate": "!newData.exists() || (newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 120 && newData.child('questions').hasChildren() && newData.child('updatedAt').val() === now)",
          "questions": {
            "$i": {
              ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 300 && (newData.child('choices').hasChildren() || newData.child('kind').val() === 'number') && newData.child('correct').isNumber() && newData.child('status').val().matches(/^(brouillon|validee)$/)",
              "duration": {
                ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
              },
              "image": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "imageId": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{16}$/)"
              }
            }
          }
        }
      },
      "images": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val() && (!data.exists() || !newData.exists())",
          ".validate": "!newData.exists() || ($id.matches(/^[0-9a-f]{16}$/) && newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 150000)"
        }
      },
      "sounds": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val() && (!data.exists() || !newData.exists())",
          ".validate": "!newData.exists() || ($id.matches(/^[0-9a-f]{16}$/) && newData.isString() && newData.val().beginsWith('data:audio/mpeg;base64,') && newData.val().length <= 900000)"
        }
      },
      "playlists": {
        "$id": {
          ".write": "auth != null && root.child('settings/admin/hash').isString() && root.child('adminProof').child(auth.uid).child('hash').val() === root.child('settings/admin/hash').val()",
          ".validate": "!newData.exists() || (newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 120 && newData.child('tracks').hasChildren() && newData.child('duration').isNumber() && newData.child('duration').val() >= 10 && newData.child('duration').val() <= 45 && newData.child('updatedAt').val() === now)",
          "points": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "finalPoints": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "finalCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
          },
          "reveal": {
            ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 20"
          },
